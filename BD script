-- =============================================
-- Base de datos: gestion_tareas
-- Sistema de gestion de tareas con MVC, JSP, Servlets y JDBC
-- =============================================

CREATE DATABASE IF NOT EXISTS gestion_tareas
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE gestion_tareas;

SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE IF EXISTS tareas;
DROP TABLE IF EXISTS grupo_usuarios;
DROP TABLE IF EXISTS grupos;
DROP TABLE IF EXISTS usuarios;
SET FOREIGN_KEY_CHECKS = 1;

-- Usuarios del sistema.
CREATE TABLE usuarios (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    rol ENUM('admin', 'usuario') DEFAULT 'usuario',
    fecha_registro TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    activo BOOLEAN DEFAULT TRUE
);

-- Grupos o equipos de trabajo.
CREATE TABLE grupos (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(100) NOT NULL,
    descripcion TEXT,
    admin_id INT NOT NULL,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    activo BOOLEAN DEFAULT TRUE,
    CONSTRAINT fk_grupos_admin
        FOREIGN KEY (admin_id) REFERENCES usuarios(id) ON DELETE CASCADE
);

-- Relacion muchos a muchos entre grupos y usuarios.
CREATE TABLE grupo_usuarios (
    grupo_id INT NOT NULL,
    usuario_id INT NOT NULL,
    fecha_union TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    activo BOOLEAN DEFAULT TRUE,
    PRIMARY KEY (grupo_id, usuario_id),
    CONSTRAINT fk_grupo_usuarios_grupo
        FOREIGN KEY (grupo_id) REFERENCES grupos(id) ON DELETE CASCADE,
    CONSTRAINT fk_grupo_usuarios_usuario
        FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE
);

-- Tareas asignadas a usuarios dentro de un grupo.
CREATE TABLE tareas (
    id INT PRIMARY KEY AUTO_INCREMENT,
    titulo VARCHAR(150) NOT NULL,
    descripcion TEXT,
    usuario_id INT NOT NULL,
    grupo_id INT NOT NULL,
    asignado_por INT NOT NULL,
    fecha_limite DATE,
    prioridad ENUM('alta', 'media', 'baja') DEFAULT 'media',
    estado ENUM('pendiente', 'en_progreso', 'completada', 'cancelada') DEFAULT 'pendiente',
    progreso INT DEFAULT 0,
    comentarios TEXT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT fk_tareas_usuario
        FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE,
    CONSTRAINT fk_tareas_grupo
        FOREIGN KEY (grupo_id) REFERENCES grupos(id) ON DELETE CASCADE,
    CONSTRAINT fk_tareas_asignado_por
        FOREIGN KEY (asignado_por) REFERENCES usuarios(id) ON DELETE CASCADE,
    CONSTRAINT chk_tareas_progreso CHECK (progreso BETWEEN 0 AND 100)
);

CREATE INDEX idx_usuarios_email ON usuarios(email);
CREATE INDEX idx_usuarios_rol ON usuarios(rol);
CREATE INDEX idx_grupos_admin ON grupos(admin_id);
CREATE INDEX idx_grupos_activo ON grupos(activo);
CREATE INDEX idx_grupo_usuarios_usuario ON grupo_usuarios(usuario_id);
CREATE INDEX idx_grupo_usuarios_activo ON grupo_usuarios(activo);
CREATE INDEX idx_tareas_usuario ON tareas(usuario_id);
CREATE INDEX idx_tareas_grupo ON tareas(grupo_id);
CREATE INDEX idx_tareas_estado ON tareas(estado);
CREATE INDEX idx_tareas_prioridad ON tareas(prioridad);
CREATE INDEX idx_tareas_fecha_limite ON tareas(fecha_limite);
CREATE INDEX idx_tareas_usuario_grupo ON tareas(usuario_id, grupo_id);

