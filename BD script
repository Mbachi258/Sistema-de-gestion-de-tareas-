-- =============================================
-- CREAR VISTAS ÚTILES
-- =============================================

-- Vista 1: Resumen de tareas por usuario
CREATE VIEW vista_resumen_usuario AS
SELECT 
    u.id AS usuario_id,
    u.nombre AS usuario_nombre,
    COUNT(t.id) AS total_tareas,
    SUM(CASE WHEN t.estado = 'pendiente' THEN 1 ELSE 0 END) AS pendientes,
    SUM(CASE WHEN t.estado = 'en_progreso' THEN 1 ELSE 0 END) AS en_progreso,
    SUM(CASE WHEN t.estado = 'completada' THEN 1 ELSE 0 END) AS completadas,
    ROUND(AVG(t.progreso), 1) AS progreso_promedio
FROM usuarios u
LEFT JOIN tareas t ON u.id = t.usuario_id
WHERE u.activo = TRUE
GROUP BY u.id, u.nombre;

-- Vista 2: Tareas atrasadas
CREATE VIEW vista_tareas_atrasadas AS
SELECT 
    t.id,
    t.titulo,
    u.nombre AS responsable,
    g.nombre AS grupo,
    t.fecha_limite,
    DATEDIFF(CURDATE(), t.fecha_limite) AS dias_atraso,
    t.prioridad
FROM tareas t
JOIN usuarios u ON t.usuario_id = u.id
JOIN grupos g ON t.grupo_id = g.id
WHERE t.estado NOT IN ('completada', 'cancelada')
AND t.fecha_limite < CURDATE()
ORDER BY dias_atraso DESC;

-- Vista 3: Estadísticas por grupo
CREATE VIEW vista_estadisticas_grupo AS
SELECT 
    g.id AS grupo_id,
    g.nombre AS grupo_nombre,
    COUNT(DISTINCT gu.usuario_id) AS total_miembros,
    COUNT(t.id) AS total_tareas,
    SUM(CASE WHEN t.estado = 'completada' THEN 1 ELSE 0 END) AS tareas_completadas,
    ROUND(AVG(t.progreso), 1) AS progreso_promedio_grupo
FROM grupos g
LEFT JOIN grupo_usuarios gu ON g.id = gu.grupo_id AND gu.activo = TRUE
LEFT JOIN tareas t ON g.id = t.grupo_id
WHERE g.activo = TRUE
GROUP BY g.id, g.nombre;

-- =============================================
-- CREAR PROCEDIMIENTOS ALMACENADOS
-- =============================================

-- Procedimiento: Asignar tarea
DELIMITER $$
CREATE PROCEDURE asignar_tarea(
    IN p_titulo VARCHAR(150),
    IN p_descripcion TEXT,
    IN p_usuario_id INT,
    IN p_grupo_id INT,
    IN p_asignado_por INT,
    IN p_fecha_limite DATE,
    IN p_prioridad VARCHAR(10)
)
BEGIN
    INSERT INTO tareas (titulo, descripcion, usuario_id, grupo_id, asignado_por, fecha_limite, prioridad)
    VALUES (p_titulo, p_descripcion, p_usuario_id, p_grupo_id, p_asignado_por, p_fecha_limite, p_prioridad);
    
    SELECT LAST_INSERT_ID() AS tarea_id;
END$$
DELIMITER ;

-- Procedimiento: Actualizar progreso de tarea
DELIMITER $$
CREATE PROCEDURE actualizar_progreso(
    IN p_tarea_id INT,
    IN p_progreso INT,
    IN p_comentario VARCHAR(255)
)
BEGIN
    UPDATE tareas 
    SET progreso = p_progreso,
        comentarios = CONCAT(IFNULL(comentarios, ''), '\n[', NOW(), '] ', p_comentario),
        estado = CASE 
            WHEN p_progreso = 0 THEN 'pendiente'
            WHEN p_progreso = 100 THEN 'completada'
            ELSE 'en_progreso'
        END
    WHERE id = p_tarea_id;
END$$
DELIMITER ;

